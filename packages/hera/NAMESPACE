# hera is built into Elara, not installed: the kernel evaluates its R files into the locked environment
# "tools:jovian" (no namespace, every name dot-named, as Ark's tools:positron) and registers these methods of base R's
# generics. hera's own generics (.elara.mime_bundle, .elara.mime_types) find their methods beside them.
S3method("$",Comm,.jv.s3.dollar.Comm)
S3method("$",CommManagerClass,.jv.s3.dollar.CommManagerClass)
S3method(print,Comm,.jv.s3.print.Comm)
S3method(print,CommManagerClass,.jv.s3.print.CommManagerClass)
S3method(print,Message,.jv.s3.print.Message)
S3method(print,hera_class,.jv.s3.print.hera_class)
S3method(print,jv_json,.jv.s3.print.jv_json)
