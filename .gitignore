# Build outputs -- dist/ is the one real output root (dist/lib, dist/native,
# dist/native-test, dist/ide/*, dist/ide-install/* -- see CMakePresets.json
# and scripts/clean.js). build/ and out/ and .cmake-js/ are legacy/
# pre-migration paths kept ignored in case a checkout still has them.
dist/
build/
out/
.cmake-js/

# Dependencies
node_modules/

# tools/playground (Next.js app) build output
.next/
next-env.d.ts
vcpkg_installed/

# TypeScript
*.tsbuildinfo
*.js.map
*.d.ts.map

# IDE
.vscode/.history/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Package files
*.tgz
*.tar.gz

# Temporary files
*.tmp
*.temp
*.swp
*~

# R
.Rhistory
.RData
.Rproj.user

# clang-format cache
.clang-format-cache
.claude

# CTest run artifacts
native/test/Testing/

# Generated by tools/jupyter-kernelspec/generate.js -- bakes in
# machine-specific absolute paths (R_HOME, the built exe), regenerate with
# `npm run jupyter:kernelspec` rather than committing one machine's copy.
kernelspec/
