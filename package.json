{
  "name": "datasuite-r",
  "version": "1.0.0",
  "type": "module",
  "description": "Unified R kernel for Jupyter and Node.js with C++ backend",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./types": {
      "import": "./dist/lib/types/index.js",
      "types": "./dist/lib/types/index.d.ts"
    }
  },
  "files": [
    "dist/lib/**/*",
    "dist/native/Release/**/*",
    "packages/hera/DESCRIPTION",
    "packages/hera/NAMESPACE",
    "packages/hera/LICENSE",
    "packages/hera/R/**/*",
    "packages/hera/man/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:native": "cmake --build dist/native --config Release",
    "build:lib": "tsc --build",
    "build": "node scripts/build.js",
    "compile": "cmake-js compile --out dist/native --CDCMAKE_TOOLCHAIN_FILE=\"%VCPKG_ROOT%/scripts/buildsystems/vcpkg.cmake\"",
    "rebuild": "npm run clean && npm run build",
    "dev": "node scripts/dev.js",
    "format": "node scripts/format.js",
    "format:check": "node scripts/format.js --dry-run",
    "lint:cpp": "clang-tidy native/src/**/*.cpp",
    "lint:ts": "eslint lib/**/*.ts",
    "lint": "npm run lint:ts && npm run lint:cpp",
    "test": "node scripts/test.js",
    "test:unit": "node --test --test-force-exit --experimental-test-coverage test/unit/lib/*.test.ts",
    "test:integration": "node --test --test-force-exit test/integration/*.test.ts",
    "pack:install": "npm pack && cd ../../JS/vscode && npm install ../../VS/datasuite-r/datasuite-r-1.0.0.tgz"
  },
  "keywords": [
    "r",
    "jupyter",
    "kernel",
    "data-science",
    "native"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "node-addon-api": "^8.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "clang-format": "^1.8.0",
    "cmake-js": "^8.0.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}