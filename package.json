{
  "name": "jovian",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Development workspace for @damurka/jovian (published from dist/release by scripts/release.mjs)",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    },
    "./types": {
      "import": "./dist/lib/types/index.js",
      "types": "./dist/lib/types/index.d.ts"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:native": "cmake --build dist/native --config Release",
    "build:lib": "tsc --build",
    "build": "node scripts/build.js",
    "compile": "cmake -S . -B dist/native -DCMAKE_TOOLCHAIN_FILE=\"%VCPKG_ROOT%/scripts/buildsystems/vcpkg.cmake\" && cmake --build dist/native --config Release",
    "rebuild": "npm run clean && npm run build",
    "dev": "node scripts/dev.js",
    "format": "node scripts/format.js",
    "format:check": "node scripts/format.js --dry-run",
    "lint:cpp": "clang-tidy native/src/**/*.cpp",
    "lint:ts": "eslint lib/**/*.ts",
    "lint": "npm run lint:ts && npm run lint:cpp",
    "test": "node scripts/test.js",
    "test:unit": "node --test --test-force-exit --experimental-test-coverage test/unit/lib/*.test.ts",
    "test:integration": "node --test --test-force-exit test/integration/*.test.ts",
    "hera:install": "R CMD INSTALL packages/hera",
    "playground": "npm --prefix tools/playground run dev",
    "playground:install": "npm --prefix tools/playground install",
    "playground:build": "npm --prefix tools/playground run build",
    "playground:start": "npm --prefix tools/playground run start",
    "jupyter:kernelspec": "node tools/jupyter-kernelspec/generate.js",
    "release:stage": "node scripts/release.mjs"
  },
  "keywords": [
    "r",
    "jupyter",
    "kernel",
    "data-science",
    "native"
  ],
  "author": "David Kariuki",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "clang-format": "^1.8.0",
    "eslint": "^9.0.0",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
